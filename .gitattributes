# 줄바꿈 정규화 — 윈도우/맥/리눅스가 섞여도 diff가 깨지지 않게 한다
* text=auto eol=lf

# 셸 스크립트는 반드시 LF (CRLF면 리눅스에서 실행 실패)
*.sh   text eol=lf
*.py   text eol=lf

# 윈도우 전용 스크립트는 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 바이너리
*.zip  binary
*.png  binary
*.jpg  binary
*.pdf  binary

# 자동 생성물임을 깃허브 언어 통계와 diff에서 표시
dist/** linguist-generated=true
